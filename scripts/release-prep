#!/usr/bin/env bash
# release-prep <X.Y.Z> — align every version surface for a release, in one step.
#
# The app version lives in THREE hand-maintained places that have measurably
# drifted before (0.8.0 / 0.19.15 / 0.19.7 on the same tree). This script is
# the one mover:
#   src-tauri/Cargo.toml        version = "X.Y.Z"     (+ src-tauri/Cargo.lock, tracked)
#   src-tauri/tauri.conf.json   "version": "X.Y.Z"    (authoritative — installer/app version)
#   ui/package.json             via `npm version` (keeps package-lock.json in sync)
# and stamps CHANGELOG.md: `## [Unreleased]` → `## [X.Y.Z] — YYYY-MM-DD`.
#
# It does NOT tag, push, build, or touch the website's version.json — those are
# maintainer-gated release steps; the checklist it prints names them.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

NEW="${1:-}"
[[ "$NEW" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "usage: scripts/release-prep X.Y.Z" >&2; exit 1; }

CUR=$(grep -om1 '"version": *"[^"]*"' src-tauri/tauri.conf.json | grep -o '[0-9][^"]*')
[ "$(printf '%s\n%s\n' "$CUR" "$NEW" | sort -V | tail -1)" = "$NEW" ] && [ "$CUR" != "$NEW" ] \
  || { echo "error: new version $NEW is not greater than current $CUR (tauri.conf.json)" >&2; exit 1; }

[ -z "$(git status --porcelain)" ] || echo "note: working tree is dirty — the bump will mix with existing changes." >&2

echo "version: $CUR -> $NEW"

# 1. The three manifests.
sed -i "0,/^version = \"[^\"]*\"/s//version = \"$NEW\"/" src-tauri/Cargo.toml
sed -i "0,/\"version\": *\"[^\"]*\"/s//\"version\": \"$NEW\"/" src-tauri/tauri.conf.json
npm version --prefix ui --no-git-tag-version --allow-same-version "$NEW" >/dev/null

# 2. Tracked lockfile follows the manifest.
cargo metadata --manifest-path src-tauri/Cargo.toml --format-version 1 >/dev/null 2>&1 \
  || echo "warn: cargo metadata failed — refresh src-tauri/Cargo.lock with the next build" >&2

# 3. CHANGELOG heading.
TODAY=$(date +%F)
if grep -q '^## \[Unreleased\]' CHANGELOG.md; then
  sed -i "0,/^## \[Unreleased\]/s//## [$NEW] — $TODAY/" CHANGELOG.md
  echo "CHANGELOG: [Unreleased] -> [$NEW] — $TODAY"
else
  echo "warn: no '## [Unreleased]' section in CHANGELOG.md — write the release notes by hand." >&2
fi

# 4. Verify alignment or die.
A=$(grep -om1 'version = "[^"]*"' src-tauri/Cargo.toml | grep -o '[0-9][^"]*')
B=$(grep -om1 '"version": *"[^"]*"' src-tauri/tauri.conf.json | grep -o '[0-9][^"]*')
C=$(node -p "require('./ui/package.json').version" 2>/dev/null || grep -om1 '"version": *"[^"]*"' ui/package.json | grep -o '[0-9][^"]*')
if [ "$A" = "$NEW" ] && [ "$B" = "$NEW" ] && [ "$C" = "$NEW" ]; then
  echo "aligned: Cargo.toml=$A tauri.conf.json=$B package.json=$C"
else
  echo "error: NOT aligned after bump: Cargo.toml=$A tauri.conf.json=$B package.json=$C" >&2; exit 1
fi

cat <<EOF

Remaining release steps (maintainer-gated — see the release runbook):
  1. Fill/review the [$NEW] CHANGELOG section; commit the bump.
  2. Tag when approved:  git tag v$NEW && git push origin v$NEW   (tag push triggers release CI)
  3. After CI publishes: SourceForge mirror + FRS, and update the site's
     /nexus/version.json (separate repo) — the update-check endpoint stays
     stale until you do.
EOF
