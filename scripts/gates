#!/usr/bin/env node
// scripts/gates — the gate list, DERIVED from .github/workflows/ci.yml.
//
// WHY THIS EXISTS. Three times in one day a hand-composed gate list came out a
// SUBSET of CI's, and the gap was only found afterwards: a batch brief that
// listed `cargo test -p tempo-core` + clippy and forgot `cargo fmt --all
// --check` (nine tasks "passed" with CI red); a merge gate that ran eight steps
// and omitted the Windows cross-compile and the UI suite (main went red on the
// push — the Windows break was a `#[cfg(windows)]` body no Linux compile ever
// type-checks); and `cargo fmt --all` silently skipping src-tauri. A memory
// saying "transcribe the list from ci.yml" already existed and was violated
// anyway. Transcription is the defect. So: nothing here is transcribed.
//
// EVERY gate below is read out of .github/workflows/ci.yml at run time. There is
// no list of jobs, no list of commands, and no list of features in this file. If
// the workflow gains a step, this script gains it with no edit — that property is
// the whole point, and scripts/gates.test.mjs holds it down by planting a step in
// a scratch copy of the workflow and asserting it appears.
//
// Usage:
//   scripts/gates                     run every gate this machine can run
//   scripts/gates --list              print every gate CI runs, grouped by job
//   scripts/gates --list --unrunnable print only what CANNOT run here, and why
//   scripts/gates --job test,ui       scope to named jobs (comma-separated)
//   scripts/gates --workflow PATH     read a different workflow (used by the tests)
//
// NEVER pipe this into grep/tail/head. A pipe discards the exit status of the
// left-hand side; this project shipped a gate faked green exactly that way in
// 1.10.3. Gates run with inherited stdio and their real exit codes are printed.

import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');

// ---------------------------------------------------------------------------
// A minimal YAML reader — enough for a GitHub workflow, and nothing more.
// Block maps, block sequences, flow sequences, quoted scalars, and the `|` / `>`
// block scalars that `run:` bodies are written in.
// ---------------------------------------------------------------------------

function stripComment(line) {
  let out = '';
  let quote = null;
  for (let k = 0; k < line.length; k++) {
    const c = line[k];
    if (quote) {
      out += c;
      if (c === quote) quote = null;
      continue;
    }
    if (c === '"' || c === "'") {
      quote = c;
      out += c;
      continue;
    }
    if (c === '#' && (k === 0 || /\s/.test(line[k - 1]))) break;
    out += c;
  }
  return out;
}

function unquote(s) {
  const t = s.trim();
  if (t.length >= 2 && ((t[0] === '"' && t.endsWith('"')) || (t[0] === "'" && t.endsWith("'")))) {
    return t.slice(1, -1);
  }
  return t;
}

function parseYaml(text) {
  const lines = text.split(/\r?\n/);
  const indentOf = (s) => s.length - s.trimStart().length;
  const ignorable = (s) => s.trim() === '' || s.trimStart().startsWith('#');
  let i = 0;

  const skip = () => {
    while (i < lines.length && ignorable(lines[i])) i++;
  };

  function blockScalar(style, ownerIndent) {
    i++;
    const body = [];
    let base = null;
    while (i < lines.length) {
      const l = lines[i];
      if (l.trim() === '') {
        body.push('');
        i++;
        continue;
      }
      const ind = indentOf(l);
      if (ind <= ownerIndent) break;
      if (base === null) base = ind;
      body.push(l.slice(Math.min(base, ind)));
      i++;
    }
    while (body.length && body[body.length - 1].trim() === '') body.pop();
    if (style === '|') return body.join('\n');
    // Folded: blank lines become breaks, everything else joins with a space.
    let out = '';
    for (const l of body) {
      if (l.trim() === '') out += '\n';
      else out += (out && !out.endsWith('\n') ? ' ' : '') + l.trim();
    }
    return out;
  }

  function scalar(raw) {
    const t = raw.trim();
    if (t.startsWith('[') && t.endsWith(']')) {
      const inner = t.slice(1, -1).trim();
      return inner === '' ? [] : inner.split(',').map(unquote);
    }
    return unquote(t);
  }

  function parseNode(indent) {
    skip();
    if (i >= lines.length) return null;
    const ind = indentOf(lines[i]);
    if (ind < indent) return null;
    const head = stripComment(lines[i]).trimStart();
    if (head === '-' || head.startsWith('- ')) return parseSeq(ind);
    return parseMap(ind);
  }

  function parseSeq(indent) {
    const arr = [];
    for (;;) {
      skip();
      if (i >= lines.length) break;
      const ind = indentOf(lines[i]);
      if (ind < indent) break;
      const head = stripComment(lines[i]).trimStart();
      if (ind !== indent || !(head === '-' || head.startsWith('- '))) break;
      // Rewrite the dash to spaces in the working copy, then the item is just a
      // node indented two past the dash — no special case for "first key inline".
      lines[i] = lines[i].slice(0, ind) + '  ' + lines[i].slice(ind + 2);
      const inner = stripComment(lines[i]).trim();
      if (!/^[^:\s][^:]*:(\s|$)/.test(inner)) {
        arr.push(scalar(inner));
        i++;
        continue;
      }
      arr.push(parseNode(ind + 2));
    }
    return arr;
  }

  function parseMap(indent) {
    const map = {};
    for (;;) {
      skip();
      if (i >= lines.length) break;
      const ind = indentOf(lines[i]);
      if (ind < indent) break;
      const content = stripComment(lines[i]).trim();
      if (content.startsWith('- ')) break;
      const m = content.match(/^([^:]+):(?:\s+(.*))?$/);
      if (!m) throw new Error(`scripts/gates: cannot parse line ${i + 1}: ${lines[i]}`);
      const key = unquote(m[1]);
      const rest = (m[2] || '').trim();
      const bs = rest.match(/^([|>])([-+]?)(\d*)$/);
      if (bs) {
        map[key] = blockScalar(bs[1], ind);
      } else if (rest === '') {
        i++;
        map[key] = parseNode(ind + 1);
      } else {
        map[key] = scalar(rest);
        i++;
      }
    }
    return map;
  }

  return parseNode(0);
}

// ---------------------------------------------------------------------------
// Workflow expressions. Anything we cannot resolve stays literal and marks the
// step unrunnable — a half-expanded command is worse than an honest refusal.
// ---------------------------------------------------------------------------

const RUNNER_TEMP = path.join(os.tmpdir(), 'nexus-gates-runner-temp');

function gitRepoSlug() {
  const r = spawnSync('git', ['-C', ROOT, 'remote', 'get-url', 'origin'], { encoding: 'utf8' });
  if (r.status !== 0) return null;
  const m = String(r.stdout).trim().match(/[:/]([^/:]+\/[^/]+?)(?:\.git)?$/);
  return m ? m[1] : null;
}

const CONTEXT = {
  'github.workspace': ROOT,
  'runner.os': 'Linux',
  'runner.temp': RUNNER_TEMP,
  'runner.arch': os.arch() === 'arm64' ? 'ARM64' : 'X64',
  'github.repository': gitRepoSlug(),
};

function expand(text, matrix) {
  const unresolved = [];
  const out = String(text).replace(/\$\{\{\s*([^}]+?)\s*\}\}/g, (whole, expr) => {
    const mm = expr.match(/^matrix\.(\w+)$/);
    if (mm && matrix && Object.prototype.hasOwnProperty.call(matrix, mm[1])) return matrix[mm[1]];
    if (Object.prototype.hasOwnProperty.call(CONTEXT, expr) && CONTEXT[expr] != null) {
      return CONTEXT[expr];
    }
    unresolved.push(expr);
    return whole;
  });
  return { text: out, unresolved };
}

// ---------------------------------------------------------------------------
// Local probes.
// ---------------------------------------------------------------------------

const whichCache = new Map();
function which(bin) {
  if (whichCache.has(bin)) return whichCache.get(bin);
  let found = null;
  if (bin.includes('/')) {
    found = fs.existsSync(path.resolve(ROOT, bin)) ? bin : null;
  } else {
    for (const dir of (process.env.PATH || '').split(path.delimiter)) {
      if (!dir) continue;
      const p = path.join(dir, bin);
      try {
        fs.accessSync(p, fs.constants.X_OK);
        found = p;
        break;
      } catch {
        /* keep looking */
      }
    }
  }
  whichCache.set(bin, found);
  return found;
}

// A shell body as the scanner should see it: continuations joined, heredoc
// bodies removed (they are data for another interpreter, not commands), and
// comments dropped. Only ever used for ANALYSIS — what gets executed is always
// the workflow's own text, byte for byte.
function scannable(command) {
  const noHeredoc = [];
  let terminator = null;
  for (const line of command.split('\n')) {
    if (terminator) {
      if (line.trim() === terminator) terminator = null;
      continue;
    }
    const h = line.match(/<<-?\s*['"]?([A-Za-z_]\w*)['"]?/);
    noHeredoc.push(line);
    if (h) terminator = h[1];
  }
  return noHeredoc
    .join('\n')
    .replace(/\\\n\s*/g, ' ')
    .split('\n')
    .map((l) => l.trim())
    .filter((l) => l && !l.startsWith('#'))
    .join('\n');
}

// Words that start a line but are not programs we can probe for.
const SHELL_WORDS = new Set([
  'set', 'export', 'echo', 'cd', 'if', 'then', 'else', 'elif', 'fi', 'for', 'do', 'done',
  'while', 'case', 'esac', 'return', 'exit', 'local', 'read', 'shift', 'trap', 'eval',
  'source', '.', '[', '[[', ':', '{', '}', 'true', 'false', 'test',
]);
// Assume a POSIX box has these; probing them only produces noise.
const COREUTILS = new Set([
  'ls', 'cat', 'cp', 'mv', 'rm', 'mkdir', 'rmdir', 'ln', 'chmod', 'touch', 'head', 'tail',
  'grep', 'sed', 'awk', 'sort', 'uniq', 'wc', 'cut', 'tr', 'find', 'xargs', 'tee', 'env',
  'basename', 'dirname', 'printf', 'sha256sum', 'file', 'which', 'sleep', 'date',
]);
// Subcommands `cargo` ships itself; anything else needs a `cargo-<sub>` binary.
const CARGO_BUILTIN = new Set([
  'build', 'check', 'test', 'run', 'bench', 'doc', 'fetch', 'update', 'tree', 'metadata',
  'install', 'clean', 'add', 'remove', 'publish', 'package', 'search', 'init', 'new', 'fix',
  'rustc', 'report', 'vendor', 'generate-lockfile', 'locate-project', 'verify-project',
]);

// The programs a command invokes, as far as the text can tell us. Deliberately
// conservative: a word this cannot confidently call a program is dropped, because
// a false "missing tool" would SKIP a gate that could have run, and a skipped
// gate is the failure this whole script exists to stop.
function programsUsed(command) {
  const progs = new Set();
  // `$(`, backticks and the control operators all start a fresh command word.
  for (const seg of scannable(command).split(/\$\(|`|\)|\|\||&&|;|\||\n/)) {
    let words = seg.trim().split(/\s+/).filter(Boolean);
    while (words.length && (words[0] === 'sudo' || /^[A-Za-z_]\w*=/.test(words[0]))) {
      words = words.slice(1);
    }
    const w = words[0];
    if (!w) continue;
    if (SHELL_WORDS.has(w) || COREUTILS.has(w)) continue;
    if (w.startsWith('-') || /[$"'*<>=[\]]/.test(w)) continue;
    // A path-shaped word is a program only if it is really there; `pi-out/trixie`
    // is an argument that lost its verb to a substitution split.
    if (w.includes('/') && !fs.existsSync(path.resolve(ROOT, w))) continue;
    progs.add(w);
    if (w === 'cargo' && words[1] && !words[1].startsWith('-') && !CARGO_BUILTIN.has(words[1])) {
      progs.add(`cargo-${words[1]}`);
    }
  }
  return [...progs];
}

// The system packages a job installs for itself, read off its own apt/brew steps
// so a new CI dependency is noticed for free. These are ADVISORY ONLY and never
// block a gate: a package name is not a binary name (`gcc-mingw-w64-x86-64`
// provides `x86_64-w64-mingw32-gcc`, `ninja-build` provides `ninja`), so the
// script cannot honestly claim one is absent. It says what it checked and how.
function packagesInstalledBy(command) {
  const pkgs = new Set();
  for (const line of scannable(command).split('\n')) {
    const m = line.match(/(?:apt-get|apt|brew)\s+install\b(.*)/);
    if (!m) continue;
    for (const w of m[1].split(/\s+/)) {
      if (!w || w.startsWith('-')) continue;
      pkgs.add(w);
    }
  }
  return [...pkgs];
}

// Is a package present? dpkg is exact where it exists; PATH is the fallback, with
// the one naming convention that is actually reliable (`x-build` ships `x`).
function packagePresent(pkg) {
  if (which(pkg) || which(pkg.replace(/-build$/, ''))) return true;
  if (which('dpkg-query')) {
    const r = spawnSync('dpkg-query', ['-W', '-f=${Status}', pkg], { encoding: 'utf8' });
    if (r.status === 0 && /\binstalled\b/.test(String(r.stdout)) && !/not-installed/.test(String(r.stdout))) {
      return true;
    }
  }
  return false;
}

// ---------------------------------------------------------------------------
// Step classification.
//
// Every step in the workflow lands in exactly one bucket and every bucket is
// printed. A step this script does not understand is reported loudly as such —
// silently dropping one is the failure this tool exists to prevent.
// ---------------------------------------------------------------------------

// Actions that provision the runner. They are not gates and have no local
// equivalent: the toolchain they install is the local box's own.
const INFRA_ACTIONS = [
  'actions/checkout', 'actions/cache', 'actions/setup-node', 'actions/upload-artifact',
  'actions/download-artifact', 'dtolnay/rust-toolchain',
];

// Actions that ARE gates, with the local command they stand for.
const ACTION_GATES = {
  'EmbarkStudios/cargo-deny-action': (w) => {
    const manifest = w && w['manifest-path'] ? ['--manifest-path', w['manifest-path']] : [];
    const cmd = (w && w.command ? String(w.command) : 'check').trim();
    return ['cargo', 'deny', ...manifest, ...cmd.split(/\s+/)].join(' ');
  },
};

// A `run:` step that only provisions the MACHINE is a prerequisite, not a gate:
// it can fail only for reasons about the box, and running it here would install
// system packages behind the operator's back.
//
// `npm ci` is deliberately NOT on this list. It installs into the repo, from a
// committed lockfile, and it goes red when that lockfile and package.json
// disagree — that is a code failure, so it is a gate like any other.
function isProvisioning(command) {
  const lines = command.split('\n').map((l) => l.trim()).filter((l) => l && !l.startsWith('#'));
  if (!lines.length) return false;
  const installer = [
    /^(sudo\s+)?(apt-get|apt|brew|rustup|dnf|yum|pacman)\b/,
    /^python3?\s+-m\s+pip\s+install\b/,
    /^pip3?\s+install\b/,
    /^cargo\s+install\b/,
    /^set\s+-/,
  ];
  return lines.every((l) => installer.some((re) => re.test(l)));
}

function isProvisioningStep(command) {
  return isProvisioning(scannable(command));
}

function classifySteps(job, matrix) {
  const steps = [];
  for (const raw of job.steps || []) {
    if (!raw) continue;
    const name = raw.name ? expand(raw.name, matrix).text : raw.uses || '(unnamed)';
    const env = {};
    let unresolved = [];
    for (const [k, v] of Object.entries(raw.env || {})) {
      const e = expand(v, matrix);
      env[k] = e.text;
      unresolved = unresolved.concat(e.unresolved);
    }
    const base = { name, env, if: raw.if || null };

    if (raw.uses) {
      const action = String(raw.uses).split('@')[0];
      if (INFRA_ACTIONS.includes(action)) {
        steps.push({ ...base, kind: 'setup', detail: `action ${raw.uses} — provisions the runner` });
        continue;
      }
      const translate = ACTION_GATES[action];
      if (translate) {
        const e = expand(translate(raw.with), matrix);
        steps.push({
          ...base,
          kind: 'gate',
          command: e.text,
          via: `action ${raw.uses}`,
          unresolved: unresolved.concat(e.unresolved),
        });
        continue;
      }
      steps.push({
        ...base,
        kind: 'unknown',
        detail: `action ${raw.uses} — no local equivalent is known to this script`,
      });
      continue;
    }

    if (typeof raw.run === 'string') {
      const e = expand(raw.run, matrix);
      const kind = isProvisioningStep(e.text) ? 'setup' : 'gate';
      steps.push({
        ...base,
        kind,
        command: e.text,
        detail: kind === 'setup' ? 'installs tooling — not run here' : undefined,
        unresolved: unresolved.concat(e.unresolved),
      });
      continue;
    }

    steps.push({ ...base, kind: 'unknown', detail: 'step has neither `run:` nor `uses:`' });
  }
  return steps;
}

// ---------------------------------------------------------------------------
// Runnability. Evaluated fresh each time it is asked, because a gate earlier in
// the run can satisfy a later one (windows-cross builds the FFTW prefix its own
// cross-compile step then needs).
// ---------------------------------------------------------------------------

function jobBlockers(jobInst) {
  const why = [];
  const runsOn = String(jobInst.runsOn || '');
  if (/^macos/.test(runsOn)) {
    why.push(`needs a macOS runner (runs-on: ${runsOn}); this box is ${process.platform}`);
  } else if (/-arm\b|-arm$|aarch64|arm64/.test(runsOn) && os.arch() !== 'arm64') {
    why.push(`needs an arm64 runner (runs-on: ${runsOn}); this box is ${os.arch()}`);
  } else if (/^windows/.test(runsOn)) {
    why.push(`needs a Windows runner (runs-on: ${runsOn}); this box is ${process.platform}`);
  }
  return why;
}

// Advisory, never blocking — see packagesInstalledBy.
function jobNotes(jobInst) {
  const notes = [];
  for (const step of jobInst.steps) {
    if (!step.command) continue;
    const missing = packagesInstalledBy(step.command).filter((p) => !packagePresent(p));
    if (missing.length) {
      notes.push(
        `could not confirm ${missing.length} package(s) CI installs in "${step.name}": ` +
          `${missing.join(', ')}. A gate below that dies on a missing dependency is why. ` +
          `(Checked dpkg and PATH; package names and binary names often differ, so this ` +
          `is a note, not a verdict — it never skips a gate.)`
      );
    }
  }
  return notes;
}

function stepBlockers(jobInst, step) {
  const why = [];
  // Gates run in workflow order, so a prerequisite an EARLIER gate in the same
  // job creates is not a blocker for a later one.
  const before = jobInst.steps.slice(0, jobInst.steps.indexOf(step));
  const earlier = before
    .filter((s) => s.kind === 'gate' && s.command)
    .map((s) => s.command)
    .join('\n');
  // `cargo install <name>` provides a binary called `<name>` — unlike an apt
  // package name, that mapping is exact, so a missing one is a real blocker for
  // every gate CI placed after the install.
  for (const s of before) {
    if (!s.command) continue;
    for (const m of scannable(s.command).matchAll(/cargo\s+install\s+([\w-]+)/g)) {
      if (!which(m[1])) {
        why.push(`\`${m[1]}\` is not on PATH — CI installs it in "${s.name}" (\`cargo install ${m[1]}\`)`);
      }
    }
  }
  if (step.unresolved && step.unresolved.length) {
    why.push(`unexpanded workflow expression: ${[...new Set(step.unresolved)].join(', ')}`);
  }
  for (const prog of programsUsed(step.command)) {
    if (!which(prog)) why.push(`\`${prog}\` is not on PATH`);
  }
  for (const [k, v] of Object.entries(step.env || {})) {
    if (!/(_PREFIX|_DIR|_HOME|_PATH)$/.test(k)) continue;
    if (!path.isAbsolute(v) || fs.existsSync(v)) continue;
    why.push(`${k}=${v} does not exist`);
  }
  const seenPrefix = new Set();
  for (const m of step.command.matchAll(/npm\s+--prefix\s+(\S+)/g)) {
    const prefix = m[1];
    if (seenPrefix.has(prefix)) continue;
    seenPrefix.add(prefix);
    const installs = new RegExp(`npm\\s+--prefix\\s+${prefix}\\s+(ci|install)\\b`);
    if (installs.test(step.command) || installs.test(earlier)) continue;
    if (!fs.existsSync(path.join(path.resolve(ROOT, prefix), 'node_modules'))) {
      why.push(
        `${prefix}/node_modules is absent, and no gate before this one installs it — ` +
          `CI's setup step \`npm --prefix ${prefix} ci\` has not run here`
      );
    }
  }
  if (/\bdocker\b/.test(step.command) && !which('docker')) why.push('docker is not available');
  return why;
}

// ---------------------------------------------------------------------------
// Derived traps. Not a list of known problems — each is a QUESTION asked of the
// workflow and the tree, so it answers itself again after every change.
// ---------------------------------------------------------------------------

function ownWorkspaceManifests() {
  // A Cargo.toml with its own `[workspace]` table is not reachable from the root
  // workspace: `--workspace` and `cargo fmt --all` both stop at the boundary.
  const found = [];
  const walk = (dir, depth) => {
    if (depth > 2) return;
    let entries;
    try {
      entries = fs.readdirSync(dir, { withFileTypes: true });
    } catch {
      return;
    }
    for (const e of entries) {
      if (e.name === 'node_modules' || e.name === 'target' || e.name.startsWith('.')) continue;
      const p = path.join(dir, e.name);
      if (e.isDirectory()) walk(p, depth + 1);
      else if (e.name === 'Cargo.toml' && p !== path.join(ROOT, 'Cargo.toml')) {
        if (/^\s*\[workspace\]\s*$/m.test(fs.readFileSync(p, 'utf8'))) {
          found.push(path.relative(ROOT, p));
        }
      }
    }
  };
  walk(ROOT, 0);
  return found;
}

function derivedTraps(jobInsts) {
  const traps = [];
  const gates = jobInsts.flatMap((j) => j.steps.filter((s) => s.kind === 'gate' && s.command));
  const allCommands = gates.map((s) => s.command).join('\n');
  const outsiders = ownWorkspaceManifests();

  for (const manifest of outsiders) {
    const covered = gates.filter((s) => s.command.includes(`--manifest-path ${manifest}`));
    if (!covered.length) {
      traps.push(
        `${manifest} declares its OWN [workspace] table, so \`--workspace\` never reaches it — ` +
          `and NO CI step names it. Everything in it is ungated.`
      );
    } else {
      const feats = new Set();
      for (const s of covered) {
        for (const m of s.command.matchAll(/--features\s+(\S+)/g)) feats.add(m[1]);
      }
      traps.push(
        `\`cargo test --workspace\` EXCLUDES ${manifest} — it declares its own [workspace] table, ` +
          `so it is not a member of the root workspace. CI reaches it only through the ` +
          `${covered.length} step(s) that pass \`--manifest-path ${manifest}\`` +
          (feats.size ? `, each with \`--features ${[...feats].join('` / `')}\`` : '') +
          `. Without the features you get ~13 phantom unresolved-crate errors; they are not real.`
      );
    }
  }

  const fmtSteps = gates.filter((s) => /\bcargo\s+fmt\b/.test(s.command));
  if (!fmtSteps.length) {
    traps.push('NO `cargo fmt` gate exists in this workflow at all.');
  } else {
    for (const manifest of outsiders) {
      const fmtd = fmtSteps.some((s) => s.command.includes(`--manifest-path ${manifest}`));
      if (!fmtd) {
        traps.push(
          `NO fmt gate covers ${manifest}: \`cargo fmt --all\` stops at the workspace boundary, ` +
            `so nothing has ever checked formatting there. \`cargo fmt --manifest-path ${manifest} ` +
            `--check\` will say how far it has drifted — and because it HAS drifted, do NOT "fix" ` +
            `it with a blanket \`cargo fmt --manifest-path ${manifest}\` inside a feature commit: ` +
            `that sweeps unrelated churn into your diff. Format the regions you touched, or land ` +
            `the sweep as its own commit.`
        );
      }
    }
  }

  // Features that appear on ONE cargo verb but not another are the shape that
  // let feature-gated code rot: linted but never run, or run but never linted.
  const byFeature = new Map();
  for (const s of gates) {
    for (const m of s.command.matchAll(/cargo\s+(\w+)[\s\S]*?--features\s+(\S+)/g)) {
      const pkg = (s.command.match(/-p\s+(\S+)/) || [])[1] || (s.command.match(/--manifest-path\s+(\S+)/) || [])[1] || '(workspace)';
      const key = `${pkg} --features ${m[2]}`;
      if (!byFeature.has(key)) byFeature.set(key, new Set());
      byFeature.get(key).add(m[1]);
    }
  }
  for (const [key, verbs] of byFeature) {
    if (!verbs.has('test') && !verbs.has('check') && verbs.has('clippy')) {
      traps.push(`\`${key}\` is LINTED but never compiled or run by any CI step.`);
    }
  }

  if (!allCommands.includes('npm') && !allCommands.includes('vitest')) {
    traps.push('No UI gate found in this workflow — the TS mirror of the Rust DTOs is ungated.');
  }
  return traps;
}

// ---------------------------------------------------------------------------
// Model assembly.
// ---------------------------------------------------------------------------

function matrixCombos(job) {
  const m = job.strategy && job.strategy.matrix;
  if (!m) return [null];
  const keys = Object.keys(m).filter((k) => Array.isArray(m[k]));
  if (!keys.length) return [null];
  let combos = [{}];
  for (const k of keys) {
    const next = [];
    for (const c of combos) for (const v of m[k]) next.push({ ...c, [k]: v });
    combos = next;
  }
  return combos;
}

function loadWorkflow(file) {
  const doc = parseYaml(fs.readFileSync(file, 'utf8'));
  if (!doc || !doc.jobs) throw new Error(`scripts/gates: no \`jobs:\` in ${file}`);
  const insts = [];
  for (const [id, job] of Object.entries(doc.jobs)) {
    for (const matrix of matrixCombos(job)) {
      const suffix = matrix ? `[${Object.entries(matrix).map(([k, v]) => `${k}=${v}`).join(',')}]` : '';
      insts.push({
        id,
        label: id + suffix,
        name: job.name ? expand(job.name, matrix).text : id,
        runsOn: job['runs-on'],
        matrix,
        steps: classifySteps(job, matrix),
      });
    }
  }
  return { file, insts };
}

// ---------------------------------------------------------------------------
// Output.
// ---------------------------------------------------------------------------

const indent = (s, pad) => s.split('\n').map((l) => pad + l).join('\n');

function printList(model, only, unrunnableOnly) {
  const selected = model.insts.filter((j) => !only || only.has(j.id));
  console.log(`gates derived from ${path.relative(ROOT, model.file)} — ${selected.length} job(s)\n`);
  let gateCount = 0;
  let blockedCount = 0;

  for (const job of selected) {
    const jb = jobBlockers(job);
    const rows = [];
    let blockedHere = 0;
    for (const step of job.steps) {
      if (step.kind !== 'gate') {
        if (!unrunnableOnly) {
          rows.push({ tag: step.kind === 'unknown' ? 'UNKNOWN' : 'setup  ', text: `${step.name} — ${step.detail}` });
        }
        continue;
      }
      gateCount++;
      const why = jb.concat(stepBlockers(job, step));
      if (why.length) {
        blockedCount++;
        blockedHere++;
      }
      if (unrunnableOnly && !why.length) continue;
      rows.push({
        tag: why.length ? 'BLOCKED' : 'gate   ',
        text:
          `${step.name}${step.via ? `  (via ${step.via})` : ''}\n` +
          indent(step.command, '    ') +
          (Object.keys(step.env).length
            ? `\n    env: ${Object.entries(step.env).map(([k, v]) => `${k}=${v}`).join(' ')}`
            : '') +
          (why.length ? `\n    WHY NOT HERE: ${why.join('; ')}` : ''),
      });
    }
    if (!rows.length) continue;
    console.log(`${job.label}  (${job.name})  runs-on: ${job.runsOn}`);
    for (const r of rows) console.log(`  ${r.tag}  ${r.text.replace(/\n/g, '\n  ')}`);
    for (const n of jobNotes(job)) console.log(`  note     ${n.replace(/\n/g, '\n           ')}`);
    if (blockedHere) {
      console.log(
        `  ==> ${blockedHere} gate(s) in this job CANNOT run here. For those, PUSHING AND READING\n` +
          `      THE CI RUN IS THE GATE — a local run is not coverage for them, however green.`
      );
    }
    console.log('');
  }

  // Always derived from EVERY job, never just the selected ones — a trap that a
  // `--job` filter could hide is a trap that bites.
  const traps = derivedTraps(model.insts);
  if (traps.length) {
    console.log('TRAPS (derived from the workflow and the tree, not remembered):');
    for (const t of traps) console.log(indent(`- ${t}`, '  ').replace(/^ {2}- /, '  - '));
    console.log('');
  }
  console.log(`${gateCount} gate(s); ${blockedCount} cannot run here (see --list --unrunnable).`);
  if (only) {
    const notShown = model.insts.filter((j) => !only.has(j.id));
    console.log(
      `SCOPED to --job ${[...only].join(',')} — ${notShown.length} other job(s) NOT listed: ` +
        `${notShown.map((j) => j.label).join(', ')}.`
    );
  }
}

function runGates(model, only) {
  const selected = model.insts.filter((j) => !only || only.has(j.id));
  fs.mkdirSync(RUNNER_TEMP, { recursive: true });
  const results = [];

  for (const job of selected) {
    const jb = jobBlockers(job);
    for (const step of job.steps) {
      if (step.kind === 'unknown') {
        results.push({ job: job.label, step: step.name, state: 'UNKNOWN', why: step.detail });
        continue;
      }
      if (step.kind !== 'gate') continue;
      const why = jb.concat(stepBlockers(job, step));
      if (why.length) {
        results.push({ job: job.label, step: step.name, state: 'SKIP', why: why.join('; ') });
        console.log(`\n=== SKIP  ${job.label} :: ${step.name}\n    ${why.join('\n    ')}`);
        continue;
      }
      console.log(`\n=== RUN   ${job.label} :: ${step.name}`);
      console.log(indent(step.command, '    '));
      const script = path.join(RUNNER_TEMP, `step-${results.length}.sh`);
      fs.writeFileSync(script, step.command);
      // `bash -e <file>` is GitHub's own default shell for `run:`. stdio is
      // inherited: no pipe touches this, so the exit status below is the real one.
      const r = spawnSync('bash', ['--noprofile', '--norc', '-e', script], {
        cwd: ROOT,
        stdio: 'inherit',
        env: {
          ...process.env,
          ...step.env,
          CI: 'true',
          RUNNER_TEMP,
          GITHUB_WORKSPACE: ROOT,
        },
      });
      const code = r.status === null ? 1 : r.status;
      console.log(`=== ${code === 0 ? 'PASS' : 'FAIL'}  exit ${code}  ${job.label} :: ${step.name}`);
      results.push({ job: job.label, step: step.name, state: code === 0 ? 'PASS' : 'FAIL', code });
    }
  }

  const notRun = model.insts.filter((j) => only && !only.has(j.id));
  const pass = results.filter((r) => r.state === 'PASS');
  const fail = results.filter((r) => r.state === 'FAIL');
  const skip = results.filter((r) => r.state === 'SKIP');
  const unknown = results.filter((r) => r.state === 'UNKNOWN');

  console.log('\n--------------------------------------------------------------');
  console.log(`ran ${pass.length + fail.length}  passed ${pass.length}  failed ${fail.length}  skipped ${skip.length}`);
  for (const r of fail) console.log(`  FAIL     ${r.job} :: ${r.step} (exit ${r.code})`);
  for (const r of unknown) console.log(`  UNKNOWN  ${r.job} :: ${r.step} — ${r.why}`);
  for (const r of skip) console.log(`  SKIPPED  ${r.job} :: ${r.step} — ${r.why}`);

  const traps = derivedTraps(model.insts);
  if (traps.length) {
    console.log('\nTRAPS:');
    for (const t of traps) console.log(`  - ${t}`);
  }

  // A scoped run must never read as full coverage — that is failure #1 from the
  // header, in the shape it actually arrived in.
  const scope = notRun.length
    ? `\nSCOPED to --job ${[...only].join(',')}: ${notRun.length} other job(s) in this workflow ` +
      `were NOT run (${notRun.map((j) => j.label).join(', ')}).`
    : '';

  if (fail.length) {
    console.log(`\nGATES FAILED — ${fail.length} of ${pass.length + fail.length} run here went red.${scope}`);
    return 1;
  }
  if (skip.length || unknown.length) {
    console.log(
      `\nPARTIAL — every gate that CAN run here passed, but ${skip.length + unknown.length} could NOT run.\n` +
        `This is NOT full coverage. For those, pushing and reading the CI run IS the gate.${scope}`
    );
    return 0;
  }
  if (notRun.length) {
    console.log(`\nSELECTED GATES PASSED — all ${pass.length} of them.${scope}`);
    return 0;
  }
  console.log('\nALL GATES PASSED (every gate in this workflow ran here).');
  return 0;
}

// ---------------------------------------------------------------------------

function main(argv) {
  const args = argv.slice(2);
  if (args.includes('--help') || args.includes('-h')) {
    // The file's own header block, and only that — the section comments below it
    // are for readers of the source, not for the terminal.
    const src = fs.readFileSync(fileURLToPath(import.meta.url), 'utf8').split('\n').slice(1);
    const header = [];
    for (const l of src) {
      if (!l.startsWith('//')) break;
      header.push(l.replace(/^\/\/ ?/, ''));
    }
    console.log(header.join('\n'));
    return 0;
  }
  let workflow = path.join(ROOT, '.github', 'workflows', 'ci.yml');
  let only = null;
  for (let k = 0; k < args.length; k++) {
    if (args[k] === '--workflow') workflow = path.resolve(args[++k]);
    else if (args[k] === '--job') only = new Set(String(args[++k]).split(',').map((s) => s.trim()));
    else if (args[k] !== '--list' && args[k] !== '--unrunnable') {
      console.error(`scripts/gates: unknown argument ${args[k]} (try --help)`);
      return 2;
    }
  }
  const model = loadWorkflow(workflow);
  if (only) {
    const known = new Set(model.insts.map((j) => j.id));
    const bad = [...only].filter((j) => !known.has(j));
    if (bad.length) {
      console.error(`scripts/gates: no such job(s): ${bad.join(', ')}\n  known: ${[...known].join(', ')}`);
      return 2;
    }
  }
  if (args.includes('--list') || args.includes('--unrunnable')) {
    printList(model, only, args.includes('--unrunnable'));
    return 0;
  }
  return runGates(model, only);
}

process.exit(main(process.argv));
