# syntax=docker/dockerfile:1.27@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# aarch64 build of Nexus for Raspberry Pi 3/4/5 (64-bit Raspberry Pi OS, Bookworm) → .deb.
#
# Build (from repo root, needs QEMU binfmt: `docker run --privileged --rm tonistiigi/binfmt --install arm64`):
#   docker buildx build --platform linux/arm64 -f scripts/Dockerfile.pi \
#       --target export --output type=local,dest=pi-out/bookworm .
# → pi-out/bookworm/Nexus_<ver>_arm64.deb
#
# Pi OS moved to Trixie (Debian 13) in late 2025 while a large installed base is still on
# Bookworm (12), and a .deb built on one won't reliably install on the other (libc/GTK/webkit
# ABI). So this is a BUILD MATRIX, not a port — same source, two bases:
#   --build-arg BASE=bookworm  --output type=local,dest=pi-out/bookworm
#   --build-arg BASE=trixie    --output type=local,dest=pi-out/trixie
# Separate dest dirs because tauri names both files identically (Nexus_<ver>_arm64.deb) —
# a shared dest would have one silently overwrite the other.
#
# Verified 2026-07-19: every build dep below resolves on BOTH bases, incl.
# libwebkit2gtk-4.1-dev (Trixie 2.52.3 — Trixie also ships webkitgtk-6.0 but kept 4.1).
# The webkit VERSION differs, so re-run the webview smoke (waterfall/map render, DMABUF-off)
# on a Trixie Pi before calling it supported.
ARG BASE=bookworm
# Every image this file builds from is pinned by digest, the frontend on line 1 included: a tag is
# whatever Docker Hub serves the day of the build. Each digest is the multi-arch index, so the arm64
# image under it is fixed too, and each base is a stage of its own so that BASE can still pick one.
# To move one, take the index digest from `docker buildx imagetools inspect debian:<base>`.
FROM debian:bookworm@sha256:f37a335e82bca302e955fa39f9dfe28f1be618f016f8a2b56318e5a5111afc26 AS debian-bookworm
FROM debian:trixie@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c AS debian-trixie
FROM debian-${BASE} AS build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget file git xz-utils python3 \
      build-essential cmake ninja-build gfortran pkg-config \
      libssl-dev libwebkit2gtk-4.1-dev libgtk-3-dev libayatana-appindicator3-dev \
      librsvg2-dev libxdo-dev libsoup-3.0-dev libfftw3-dev libboost-dev patchelf \
      libasound2-dev libudev-dev libusb-1.0-0-dev \
    && rm -rf /var/lib/apt/lists/*
# Debian's apt node (18) is too old for the vite build — use NodeSource 22 (matches the dev box).
#
# ⚠️ …AND THEN UPGRADE npm, which is the load-bearing half. NodeSource 22 bundles npm 10.9.8,
# but `ui/package-lock.json` is written by npm 11 (the dev box and every ci.yml job, which runs
# node 24). npm 10 disagrees with that lock about vitest 4's dependency tree — it demands
# esbuild@0.28.2, a package npm 11 never had reason to record. `npm install` hid the
# disagreement by re-resolving at build time; the moment build-linux.sh switched to `npm ci`
# (#72) it became a hard failure and BOTH Pi jobs went red while every other job stayed green.
#
# Pinning the npm MAJOR rather than moving the Node major is deliberate: node 22 is what has
# built every working Pi .deb to date and what the dev box runs, and the fault was never the
# runtime — it was the resolver. If ui/package-lock.json is ever regenerated by a newer npm,
# this pin moves with it.
#
# Node.js is NodeSource's arm64 package as a file, checked against the sha256 their signed apt index
# lists for it, not `curl | bash` of their setup script, which added their apt source and installed
# whatever nodejs 22.x it served that day. apt installs the file, so its dependencies still come from
# Debian. To move it, take a newer nodejs_22.* entry's Filename and SHA256 from
# https://deb.nodesource.com/node_22.x/dists/nodistro/main/binary-arm64/Packages, whose InRelease is
# signed by NodeSource's key 6F71F525282841EEDAF851B42F59B5F99B1BE0B4. npm is an exact version, which
# the registry never lets anyone publish twice.
RUN curl -fsSLo /tmp/nodejs.deb https://deb.nodesource.com/node_22.x/pool/main/n/nodejs/nodejs_22.23.3-1nodesource1_arm64.deb \
    && echo "94daeb24f6121cc7b684b1bb025f098761f2af1625923283e8377506004dec56  /tmp/nodejs.deb" | sha256sum -c - \
    && apt-get update && apt-get install -y --no-install-recommends /tmp/nodejs.deb \
    && rm -f /tmp/nodejs.deb \
    && npm install -g npm@11.21.0 \
    && rm -rf /var/lib/apt/lists/*
# Rust pinned to CI's toolchain, installed by a pinned rustup-init rather than sh.rustup.rs, a script
# that fetches whichever rustup is current. The sha256 is the one static.rust-lang.org publishes
# beside the file (rustup-init.sha256), and the one rust-lang/docker-rust pins for rustup 1.29.1.
# Move the version and the sum together.
RUN curl --proto '=https' --tlsv1.2 -sSfLo /tmp/rustup-init https://static.rust-lang.org/rustup/archive/1.29.1/aarch64-unknown-linux-gnu/rustup-init \
    && echo "15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --default-toolchain 1.93.1 --profile minimal \
    && rm -f /tmp/rustup-init
ENV PATH="/root/.cargo/bin:${PATH}"
WORKDIR /src
COPY . .
# The WSJT-X-derived modem source is vendored in-tree at libtempo/vendor/wsjtx and is what
# CMakeLists.txt uses by DEFAULT, so nothing needs staging here — the checkout is
# self-contained. (This previously had to recreate an absolute dev-box path inside the
# image because CMakeLists hardcoded it; WX is now an overridable CACHE PATH, so if you
# ever need a different tree, pass `--build-arg WX=/opt/wsjtx-source` and COPY it there.)
# Pi OS is Debian → ship the .deb only (arm64 AppImage tooling is flaky under emulation).
# sed only the container's copy, so the host's running build is untouched.
#
# ALSO turn OFF createUpdaterArtifacts for this build. With a `pubkey` configured, Tauri HARD
# ERRORS when the private key is absent — "A public key has been found, but no private key" —
# and the signing secrets are deliberately not passed into this container. The .deb is
# apt-managed and can never self-update, so there is nothing here to sign; without this sed the
# .deb builds successfully and then the run fails at the signing step (broke the 0.18.0 Pi debs
# and both CI Pi jobs). Do not "fix" this by handing the container the signing key: a key that
# does not need to exist in a container should not be in one.
#
# The ClubLog key is the one secret this RUN can see, because option_env! compiles it into the
# app (#388). The release passes it with `--secret id=clublog_api_key,env=CLUBLOG_API_KEY`, and
# the mount hands it to this RUN alone, never to a layer or the image's history. A build without
# the secret (ci.yml's, or yours) skips the mount and makes a package with no key, like any
# source build.
RUN --mount=type=secret,id=clublog_api_key,env=CLUBLOG_API_KEY \
    sed -i 's/--bundles deb,appimage/--bundles deb/' scripts/build-linux.sh \
    && sed -i 's/"createUpdaterArtifacts": true/"createUpdaterArtifacts": false/' src-tauri/tauri.conf.json \
    && ./scripts/build-linux.sh
RUN mkdir /out && cp src-tauri/target/release/bundle/deb/*.deb /out/

FROM scratch AS export
COPY --from=build /out/ /
