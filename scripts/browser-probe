#!/usr/bin/env bash
# scripts/browser-probe — run ONE compiled-browser scenario against real Chrome, in ~90 seconds.
#
# WHY THIS EXISTS. jsdom never lays out. Every fast gate in this project — `npm test` in ui/,
# the vitest cockpit suites, `scripts/gates --job ui` — runs in jsdom, where every element has
# zero width and zero height, no element stacks over another, and `elementFromPoint` answers
# nothing. So the entire class of "the control moved", "something else is now on top of it" and
# "the click no longer reaches the row" is INVISIBLE to all of them, and they stay green while
# an operator-visible regression ships. The only instrument in this repo that can see it is the
# `remote-browser` CI job, which drives a real Chrome — and the whole job is 28 scenarios and
# roughly 48 minutes, which is why nobody ran it before pushing.
#
# The incident it was written after (2026-09-22). A change made a log row's comment cell a
# full-width button and gave it `stopPropagation()`. Both halves were reasonable on their own;
# together the button covered the row and swallowed the click that opens the lookup card, so a
# shipped behaviour — click a recall row, get the station's card — silently stopped working.
# The UI suite passed. `tsc -b` passed. `scripts/gates --job ui` passed. Three separate reviews
# flagged "geometry is not verifiable here" and filed it as a caveat rather than a blocker.
# CI caught it on the push, and attributing the red then cost most of an afternoon of bisecting.
# ONE scenario of the browser job, run locally in ninety seconds, would have caught it before the
# push — the instrument existed the whole time and needed a name and one command.
#
# So: any change under `ui/` runs this before it is pushed. Not the whole job; one scenario.
#
# WHAT IT PROVES, and the line matters: that the compiled hosted browser still builds, mounts,
# signs in, and lays out — with real boxes, real stacking and real hit-testing. It is a SMOKE
# test of the geometry, not coverage of it. It runs ONE of the suite's scenarios and prints the
# ratio on every run. A green here is not a green `remote-browser` job; CI is still the gate.
#
# ⚠️ WHAT IT CANNOT PROVE, and this is not theoretical. One scenario runs in a fresh process.
# CI's shards run NINE in series in ONE process, so anything needing accumulated state, load or
# elapsed time to show up is invisible to a single-scenario run. Found the day this was written:
# CI's shard 0 went red on a Tempo reachability assertion at v10, and that same scenario passed
# here twice — on the same tree, and on origin/main. **When CI's browser job is red and this is
# green, reproduce CI's SHARD, not the scenario.** That is what `--shard N` is for.
#
# IF IT COMES BACK RED, PROBE `origin/main` BEFORE CONCLUDING ANYTHING. A red proves the tree
# you ran it on fails, not that your change caused it — that is this project's most-repeated
# defect class, and it bit during the incident above: four different causes were confidently
# named and all four died to a control. Build a throwaway worktree at origin/main, run the same
# scenario there, and only then attribute:
#
#     git worktree add /tmp/probe-control origin/main && scripts/browser-probe   # from there
#
# Requires Chrome on PATH and `npm ci` already done in ui/ and remote/.
set -u

usage() {
  cat >&2 <<USAGE
usage: scripts/browser-probe [--scenario <pattern>] [--no-build]

  --scenario <pattern>  matched against the suite's test NAMES (node --test
                        --test-name-pattern). Default 'v4'. The names are built in
                        the test() title in remote/test/browser.test.mjs, next to
                        the SCENARIOS table: 'v4'..'v17' for the application
                        versions, and 'operations', 'FT operating', 'quick layout',
                        'session layout', 'contact continuity', 'DX work',
                        'radio selection', 'routed decoder', 'routed workspace'.
                        Match by NAME, never by shard index — inserting an
                        application version renumbers every scenario after it.
  --shard <n>           run CI's shard <n> of 3 entire — all nine of its scenarios
                        in one process, exactly as the remote-browser job does
                        (~15-20 min). The ONLY local run that can reproduce a
                        failure caused by state or timing accumulating ACROSS
                        scenarios; a single --scenario run cannot see one.
  --no-build            reuse the existing bundles — ONLY valid if nothing has
                        changed under ui/ or remote/ since the last build, because
                        the sweep loads the BUILT worker, never the source

exit: 0 the scenario passed · 1 it failed · 2 usage, or the pattern matched no test
USAGE
}

SCENARIO='v4'
SHARD=''
BUILD=1
while [ $# -gt 0 ]; do
  case "$1" in
    --scenario) [ $# -ge 2 ] || { usage; exit 2; }; SCENARIO="$2"; shift 2 ;;
    --shard)    [ $# -ge 2 ] || { usage; exit 2; }; SHARD="$2"; shift 2
                case "$SHARD" in 0|1|2) ;; *) echo "browser-probe: --shard takes 0, 1 or 2 (CI runs three)" >&2; exit 2 ;; esac ;;
    --no-build) BUILD=0; shift ;;
    -h|--help)  usage; exit 0 ;;
    *)          echo "browser-probe: unknown argument '$1'" >&2; usage; exit 2 ;;
  esac
done

# Derived, never spelled out — this file is public and must not carry anyone's paths.
ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel 2>/dev/null)" || {
  echo "browser-probe: not inside a git worktree" >&2; exit 2; }
SUITE="$ROOT/remote/test/browser.test.mjs"
[ -f "$SUITE" ] || { echo "browser-probe: cannot find $SUITE" >&2; exit 2; }

command -v google-chrome >/dev/null 2>&1 || command -v google-chrome-stable >/dev/null 2>&1 || {
  echo "browser-probe: no google-chrome on PATH — this probe drives a REAL browser" >&2; exit 2; }

if [ "$BUILD" = 1 ]; then
  # Two builds, in this order, and both are load-bearing. The sweep loads `remote/dist/index.js`
  # (runtime.mjs), never remote/src, and that worker serves the hosted UI bundle that
  # `build:remote` emits. Skipping either one probes the LAST build and reports it as this one.
  echo "browser-probe: building the hosted UI bundle (ui -> build:remote)"
  npm --prefix "$ROOT/ui" run build:remote || { echo "browser-probe: ui build FAILED" >&2; exit 1; }
  echo "browser-probe: bundling the Cloudflare service (remote -> build)"
  WRANGLER_SEND_METRICS=false npm --prefix "$ROOT/remote" run build || {
    echo "browser-probe: remote bundle FAILED" >&2; exit 1; }
fi

LOG="$(mktemp -t browser-probe.XXXXXX.log)"
if [ -n "$SHARD" ]; then
  echo "browser-probe: running CI SHARD $SHARD of 3 entire against $(google-chrome --version 2>/dev/null || echo Chrome)"
else
  echo "browser-probe: running scenario pattern '$SCENARIO' against $(google-chrome --version 2>/dev/null || echo Chrome)"
fi

# SHARDS=1 registers every scenario and --test-name-pattern selects among them by NAME.
# The pipe here is deliberate and does NOT discard the status: PIPESTATUS[0] is the runner's
# own exit code, and it is the only thing this script reports on. (The project's rule is that a
# gate must never be piped into grep/tail and judged by the pipeline's status — the log is read
# AFTER the real code is captured, and only to tell "0 tests ran" from "1 test passed".)
cd "$ROOT/remote" || exit 2
if [ -n "$SHARD" ]; then
  # Exactly what the remote-browser job runs, env and all — no name pattern, nine scenarios in
  # this one process. Mirroring CI's command surface is the point; a paraphrase of it is not
  # evidence about CI.
  NEXUS_BROWSER_SHARDS=3 NEXUS_BROWSER_SHARD="$SHARD" \
    node --test "$SUITE" 2>&1 | tee "$LOG"
else
  NEXUS_BROWSER_SHARDS=1 NEXUS_BROWSER_SHARD=0 \
    node --test --test-name-pattern="$SCENARIO" "$SUITE" 2>&1 | tee "$LOG"
fi
RC=${PIPESTATUS[0]}

# A pattern that matches nothing exits 0 with every test skipped, and THE RUNNER'S OWN SUMMARY
# CANNOT TELL YOU THAT: `node --test <file>` reports the FILE itself as one passing test, so a
# pattern matching nothing still prints `# pass 1`, and a pattern matching one scenario that
# contains four subtests prints `# pass 5`. Both were verified before this guard was written.
# The aggregate is insensitive to the only question being asked, which is this project's
# commonest vacuous check — so count the scenarios instead. A scenario is an UNINDENTED TAP
# result line (inner subtests are indented) whose description is not the file path.
scenario_lines() { awk -v want="$1" '
  /^(ok|not ok) [0-9]+ - /{
    verdict = ($1 == "not") ? "fail" : "pass"
    desc = $0; sub(/^(ok|not ok) [0-9]+ - /, "", desc)
    if (desc !~ /\.mjs$/ && (want == "any" || want == verdict)) n++
  } END { print n+0 }' "$LOG"; }
RAN=$(scenario_lines any)
FAILED=$(scenario_lines fail)
PASSED=$((RAN - FAILED))
echo
if [ "$RAN" = 0 ]; then
  echo "browser-probe: NOTHING RAN for '${SHARD:+shard }${SHARD:-$SCENARIO}', so nothing is proven." >&2
  echo "browser-probe: the scenario names are in remote/test/browser.test.mjs (see --help)." >&2
  rm -f "$LOG"; exit 2
fi

# The suite prints its own scenario total on every run. Read it back rather than writing a
# number here: the count changes whenever an application version is added, and a transcribed
# one rots silently. (The suite's own header comment said 28 while the table held 27.)
TOTAL=$(sed -n 's/.*browser shard [0-9]* of [0-9]*: running [0-9]* of \([0-9]*\) scenarios.*/\1/p' "$LOG" | tail -1)
if [ "$RC" = 0 ]; then
  echo "browser-probe: PASS — ${PASSED} of ${TOTAL:-?} scenarios, in a real browser."
  if [ -n "$SHARD" ]; then
    echo "browser-probe: NOT COVERED — CI's other two shards, and everything outside remote/."
  else
    echo "browser-probe: NOT COVERED — every other scenario, every other application version, and"
    echo "browser-probe: everything outside remote/. A failure that needs state or timing to build"
    echo "browser-probe: up ACROSS scenarios cannot appear here; use --shard N for that."
  fi
else
  echo "browser-probe: FAIL (exit $RC) — ${FAILED:-?} scenario(s) red. Full log: $LOG" >&2
  echo "browser-probe: before blaming your change, run the SAME scenario on origin/main:" >&2
  echo "browser-probe:   git worktree add /tmp/probe-control origin/main" >&2
  echo "browser-probe: a red on both is not your change." >&2
  exit "$RC"
fi
rm -f "$LOG"
exit 0
