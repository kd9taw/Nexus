#!/usr/bin/env bash
# scripts/browser-probe — run ONE compiled-browser scenario against real Chrome, in ~90 seconds.
#
# WHY THIS EXISTS. jsdom never lays out. Every fast gate in this project — `npm test` in ui/,
# the vitest cockpit suites, `scripts/gates --job ui` — runs in jsdom, where every element has
# zero width and zero height, no element stacks over another, and `elementFromPoint` answers
# nothing. So the entire class of "the control moved", "something else is now on top of it" and
# "the click no longer reaches the row" is INVISIBLE to all of them, and they stay green while
# an operator-visible regression ships. The only instrument in this repo that can see it is the
# `remote-browser` CI job, which drives a real Chrome — and the whole job is 28 scenarios and
# roughly 48 minutes, which is why nobody ran it before pushing.
#
# The incident it was written after (2026-09-22). A change made a log row's comment cell a
# full-width button and gave it `stopPropagation()`. Both halves were reasonable on their own;
# together the button covered the row and swallowed the click that opens the lookup card, so a
# shipped behaviour — click a recall row, get the station's card — silently stopped working.
# The UI suite passed. `tsc -b` passed. `scripts/gates --job ui` passed. Three separate reviews
# flagged "geometry is not verifiable here" and filed it as a caveat rather than a blocker.
# CI caught it on the push, and attributing the red then cost most of an afternoon of bisecting.
# ONE scenario of the browser job, run locally in ninety seconds, would have caught it before the
# push — the instrument existed the whole time and needed a name and one command.
#
# So: any change under `ui/` runs this before it is pushed. Not the whole job; one scenario.
#
# WHAT IT PROVES, and the line matters: that the compiled hosted browser still builds, mounts,
# signs in, and lays out — with real boxes, real stacking and real hit-testing. It is a SMOKE
# test of the geometry, not coverage of it. It runs ONE of the suite's scenarios and prints the
# ratio on every run. A green here is not a green `remote-browser` job; CI is still the gate.
#
# ⚠️ WHAT IT CANNOT PROVE, and this is not theoretical. One scenario runs in a fresh process.
# CI's shards ran NINE in series in ONE process, so anything needing accumulated state, load or
# elapsed time to show up was invisible to a single-scenario run. Found the day this was written:
# CI's shard 0 went red on a Tempo reachability assertion at v10, and that same scenario passed
# here twice — on the same tree, and on origin/main. **When CI's browser job is red and this is
# green, reproduce CI's SHARD, not the scenario.** That is what `--shard N` is for.
#
# IF IT COMES BACK RED, PROBE `origin/main` BEFORE CONCLUDING ANYTHING. A red proves the tree
# you ran it on fails, not that your change caused it — that is this project's most-repeated
# defect class, and it bit during the incident above: four different causes were confidently
# named and all four died to a control. Build a throwaway worktree at origin/main, run the same
# scenario there, and only then attribute:
#
#     git worktree add /tmp/probe-control origin/main && scripts/browser-probe   # from there
#
# Requires Chrome on PATH and `npm ci` already done in ui/ and remote/.
set -u

usage() {
  cat >&2 <<USAGE
usage: scripts/browser-probe [--scenario <pattern>] [--no-build]
       scripts/browser-probe --desktop rotor|contestlog|spots|callcard|activation|voicenote|contactcard|atu|jtty|waterfalls|txmeters|radioswitch|logwaiting|topbar|header|rttyfit|firstrun|aprsmap

  --scenario <pattern>  matched against the suite's test NAMES (node --test
                        --test-name-pattern). Default 'stream'. The names are built
                        in the test() title in remote/test/browser.test.mjs, next
                        to the SCENARIOS table: 'stream' (Remote as a stream, end
                        to end in real Chrome) and 'phone' (the same at a phone's
                        size). Match by NAME, never by shard index.
  --shard <n>           run CI's shard <n> of 2 entire, in one process, exactly as
                        the remote-browser job does.
  --no-build            reuse the existing bundles — ONLY valid if nothing has
                        changed under ui/ or remote/ since the last build, because
                        the sweep loads the BUILT worker, never the source
  --desktop rotor       a desktop box the hosted page never shows, in real Chrome:
                        the Rotor box beside a cockpit with a call in its log entry,
                        in the stock dashboard rail, asserting its line 1 and both
                        lines of its line 2 ("→ EC1DD 227° …", "27° off", Point) are
                        on screen, with a control that must come back clipped
                        (ui/probe/desktop-probe.mjs; it builds nothing)
  --desktop contestlog  the contest logger window at its 420×320 floor, at 640×480
                        and at 2560×1440, asserting the Call box, the exchange boxes,
                        Log, the dupe warning, the newest contact and Keep in front
                        are on screen, with a control below the floor that must come
                        back clipped (ui/probe/contestlog-probe.mjs; it builds nothing)
  --desktop spots       the Spots window: the board's natural footprint measured at 100%,
                        then the window at its default and smallest sizes in both themes,
                        asserting the head, every filter chip, every column heading and the
                        first rows are on screen and the last row is reached by scrolling,
                        with a control below the smallest that must come back clipped
                        (ui/probe/spots-probe.mjs; it builds nothing)
  --desktop callcard    the station card beside the transmit controls: a call just above
                        the TX strip and dock, and one above FT's QSO strip, clicked at
                        1366×768 and 1024×768, asserting the card is drawn and covers no
                        point of the strip, Stop TX, the dock or the QSO strip, with a
                        control (the transmit classes removed) where it must cover one
                        (ui/probe/callcard-probe.mjs; it builds nothing)
  --desktop activation  the Activation pane in the dashboard rail beside a TX strip and dock,
                        in its own window, and the "Activation over?" checklist, at 1024×768
                        and 1920×1080, asserting nothing scrolls sideways, the pane's lines
                        and the checklist's buttons are on screen and no transmit control is
                        covered, with a control (a planted overflow, the TX boxes drawn over
                        the rail) that must be caught (ui/probe/activation-probe.mjs)
  --desktop voicenote   the voice keyer's Flex DAX note after F1, in a Phone-shaped pane
                        region over a TX dock, at 1024×768, 1366×768 and 1920×1080,
                        asserting nothing scrolls sideways, the note, Got it and F1 are
                        on screen, the dock is clear and Got it dismisses it, with a
                        planted overflow that must be caught (ui/probe/voicenote-probe.mjs)
  --desktop contactcard the Logbook's contact card opened by a real double-click on a call,
                        at 1024×768, 1366×768 and 1920×1080, asserting it is inside the
                        window, scrolls nowhere sideways, draws the callbook photo, keeps
                        Save and Cancel on screen at its top and foot and lists ten recent
                        contacts, with a control (the Save bar in the flow) that must hide
                        Save (ui/probe/contactcard-probe.mjs)
  --desktop atu         the TX strip's ATU button and its "Switch tuner out" menu at 1024×768
                        and 1920×1080 in both themes, asserting nothing scrolls sideways, the
                        strip's four controls are on screen, Stop TX does not move for ATU ON,
                        ATU ON is lit, a click tunes, and the right-click and long-press menu
                        switches the tuner out clear of Stop TX, with a planted overflow and a
                        cover that must be caught (ui/probe/atu-probe.mjs)
  --desktop jtty        the JTTY screen (the real cockpit) at 1024×768, 1366×768 and
                        1920×1080: the dock's Messages box, Edit keys and the eight
                        F-keys (and, while editing, the eight key boxes and Defaults)
                        and the Log QSO prompt's words, Log QSO and Not now on screen,
                        with a control (a box over Messages and Log QSO) that must be
                        seen as covered (ui/probe/jtty-probe.mjs)
  --desktop waterfalls  every mode's waterfall in the real app at 1024×768, 1366×768,
                        1920×1080 and 2560×1440, asserting each starts at 25 % of its
                        cockpit (or the layout's ceiling) and all are the same width and,
                        where the layout lets them, the same height; Stop TX, Tune and PTT
                        on screen; Phone's scope full width beside its left side; Tempo
                        stacked; with a moved divider and a planted margin that must be
                        caught (ui/probe/waterfalls-probe.mjs; it builds nothing)
  --desktop txmeters    the transmit meters in Phone's dock (with the COMP row's level bar,
                        PROC and transmit-bandwidth chip) and Operate's telemetry cell, with a
                        radio and an amplifier temperature, at 1024×768 °C and 1920×1080 °F,
                        asserting nothing scrolls sideways, every control and temperature is on
                        screen, and a real drag and clicks reach the verbs, with a planted
                        overflow that must be caught (ui/probe/txmeters-probe.mjs)
  --desktop radioswitch the radio switch notice and the Radios card in the real app, at
                        1024×768 and 1920×1080: Nexus switches radio by itself, the notice
                        and its Undo and Why? are on screen, Undo selects the radio it left,
                        Why? opens Settings at the Radios cards, whose routing lines and switch
                        choice are on screen with nothing sideways, with a planted overflow in
                        the notice and in a card that must be caught (ui/probe/radioswitch-probe.mjs)
  --desktop logwaiting  the Operate strip's Log button with a count of contacts waiting for
                        Log QSO, at 1024×768 and 1920×1080 in both themes, with and without a
                        station on screen, asserting no control moves for the count, the count
                        is drawn whole and covers none, Log stays topmost and live and a click
                        reaches it, with a control (the count in the flow) that must be caught
                        (ui/probe/logwaiting-probe.mjs; it builds nothing)
  --desktop topbar      the top bar on the FT screen and on CW at the common full-screen sizes
                        and 125/150 % on a 1080p screen, without and with a status-lane message,
                        asserting the message changes neither the bar's height nor the line any
                        group sits on, shows its flag, and nothing runs past the window, with a
                        control (the lane's old sizing) that must make the bar taller
                        (ui/probe/topbar-probe.mjs; it builds nothing)
  --desktop header      the cockpit header with a CW header's controls, 1024 to 2560 wide and
                        110-175 % on 1920×1080, asserting ⊞ Panels and CAT never take a line of
                        their own while the mode controls' last line has room for them and
                        nothing runs past the window, with the header's previous shape as the
                        control (ui/probe/header-probe.mjs; it builds nothing)
  --desktop rttyfit     the RTTY screen in the real app at the common full-screen sizes and at
                        125/150 % on 1920×1080 and 1366×768, with the tuning scope shown and
                        hidden, asserting the cockpit scrolls no more than 1.21.0's did there
                        (not at all wherever 1.21.0 fit) and, where it does not scroll, Stop TX,
                        Tune, the Esc/Stop macro, the TX latch and the scope's nudges are on
                        screen, with a planted margin that must be caught
                        (ui/probe/rttyfit-probe.mjs; it builds nothing)
  --desktop firstrun    a fresh install's first-run wizard in the real app, at 1024×768 and
                        1920×1080: the About-you question and its answers on screen, Finish
                        writes the answer, the Getting started guide then the first-contact
                        walk on screen, and Settings folded for a new operator with Show all
                        opening it, with a planted overflow in an answer and in the walk that
                        must be caught (ui/probe/firstrun-probe.mjs)
  --desktop aprsmap     the APRS screen's map in the real app, at 1024×768 and 1920×1080: nothing
                        scrolls sideways, Stop TX and the TX latch on screen, every control of the
                        map's toolbar inside the map, the Layers panel on it, the map drawn, and a
                        station's card opening inside the map with Follow on screen, with a toolbar
                        forced onto one row that must be caught (ui/probe/aprsmap-probe.mjs)

exit: 0 the scenario passed · 1 it failed · 2 usage, or the pattern matched no test
USAGE
}

SCENARIO='stream'
SHARD=''
BUILD=1
DESKTOP=''
while [ $# -gt 0 ]; do
  case "$1" in
    --scenario) [ $# -ge 2 ] || { usage; exit 2; }; SCENARIO="$2"; shift 2 ;;
    --shard)    [ $# -ge 2 ] || { usage; exit 2; }; SHARD="$2"; shift 2
                case "$SHARD" in 0|1) ;; *) echo "browser-probe: --shard takes 0 or 1 (CI runs two)" >&2; exit 2 ;; esac ;;
    --no-build) BUILD=0; shift ;;
    --desktop)  [ $# -ge 2 ] || { usage; exit 2; }; DESKTOP="$2"; shift 2
                case "$DESKTOP" in rotor|contestlog|spots|callcard|activation|voicenote|contactcard|atu|jtty|waterfalls|txmeters|radioswitch|logwaiting|topbar|header|rttyfit|firstrun|aprsmap) ;; *) echo "browser-probe: --desktop takes rotor, contestlog, spots, callcard, activation, voicenote, contactcard, atu, jtty, waterfalls, txmeters, radioswitch, logwaiting, topbar, header, rttyfit, firstrun or aprsmap" >&2; exit 2 ;; esac ;;
    -h|--help)  usage; exit 0 ;;
    *)          echo "browser-probe: unknown argument '$1'" >&2; usage; exit 2 ;;
  esac
done

# Derived, never spelled out — this file is public and must not carry anyone's paths.
ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel 2>/dev/null)" || {
  echo "browser-probe: not inside a git worktree" >&2; exit 2; }
SUITE="$ROOT/remote/test/browser.test.mjs"
[ -f "$SUITE" ] || { echo "browser-probe: cannot find $SUITE" >&2; exit 2; }

command -v google-chrome >/dev/null 2>&1 || command -v google-chrome-stable >/dev/null 2>&1 || {
  echo "browser-probe: no google-chrome on PATH — this probe drives a REAL browser" >&2; exit 2; }

# A desktop box: the app's own source, served by its own Vite config, so there is nothing to build.
if [ -n "$DESKTOP" ]; then
  [ "$DESKTOP" = contestlog ] && exec node "$ROOT/ui/probe/contestlog-probe.mjs"
  [ "$DESKTOP" = spots ] && exec node "$ROOT/ui/probe/spots-probe.mjs"
  [ "$DESKTOP" = callcard ] && exec node "$ROOT/ui/probe/callcard-probe.mjs"
  [ "$DESKTOP" = activation ] && exec node "$ROOT/ui/probe/activation-probe.mjs"
  [ "$DESKTOP" = voicenote ] && exec node "$ROOT/ui/probe/voicenote-probe.mjs"
  [ "$DESKTOP" = contactcard ] && exec node "$ROOT/ui/probe/contactcard-probe.mjs"
  [ "$DESKTOP" = atu ] && exec node "$ROOT/ui/probe/atu-probe.mjs"
  [ "$DESKTOP" = jtty ] && exec node "$ROOT/ui/probe/jtty-probe.mjs"
  [ "$DESKTOP" = waterfalls ] && exec node "$ROOT/ui/probe/waterfalls-probe.mjs"
  [ "$DESKTOP" = txmeters ] && exec node "$ROOT/ui/probe/txmeters-probe.mjs"
  [ "$DESKTOP" = logwaiting ] && exec node "$ROOT/ui/probe/logwaiting-probe.mjs"
  [ "$DESKTOP" = radioswitch ] && exec node "$ROOT/ui/probe/radioswitch-probe.mjs"
  [ "$DESKTOP" = firstrun ] && exec node "$ROOT/ui/probe/firstrun-probe.mjs"
  [ "$DESKTOP" = topbar ] && exec node "$ROOT/ui/probe/topbar-probe.mjs"
  [ "$DESKTOP" = header ] && exec node "$ROOT/ui/probe/header-probe.mjs"
  [ "$DESKTOP" = rttyfit ] && exec node "$ROOT/ui/probe/rttyfit-probe.mjs"
  [ "$DESKTOP" = aprsmap ] && exec node "$ROOT/ui/probe/aprsmap-probe.mjs"
  exec node "$ROOT/ui/probe/desktop-probe.mjs" "$DESKTOP"
fi

if [ "$BUILD" = 1 ]; then
  # Two builds, in this order, and both are load-bearing. The sweep loads `remote/dist/index.js`
  # (runtime.mjs), never remote/src, and that worker serves the hosted UI bundle that
  # `build:remote` emits. Skipping either one probes the LAST build and reports it as this one.
  echo "browser-probe: building the hosted UI bundle (ui -> build:remote)"
  npm --prefix "$ROOT/ui" run build:remote || { echo "browser-probe: ui build FAILED" >&2; exit 1; }
  echo "browser-probe: bundling the Cloudflare service (remote -> build)"
  WRANGLER_SEND_METRICS=false npm --prefix "$ROOT/remote" run build || {
    echo "browser-probe: remote bundle FAILED" >&2; exit 1; }
fi

LOG="$(mktemp -t browser-probe.XXXXXX.log)"
if [ -n "$SHARD" ]; then
  echo "browser-probe: running CI SHARD $SHARD of 2 entire against $(google-chrome --version 2>/dev/null || echo Chrome)"
else
  echo "browser-probe: running scenario pattern '$SCENARIO' against $(google-chrome --version 2>/dev/null || echo Chrome)"
fi

# SHARDS=1 registers every scenario and --test-name-pattern selects among them by NAME.
# The pipe here is deliberate and does NOT discard the status: PIPESTATUS[0] is the runner's
# own exit code, and it is the only thing this script reports on. (The project's rule is that a
# gate must never be piped into grep/tail and judged by the pipeline's status — the log is read
# AFTER the real code is captured, and only to tell "0 tests ran" from "1 test passed".)
cd "$ROOT/remote" || exit 2
if [ -n "$SHARD" ]; then
  # Exactly what the remote-browser job runs, env and all — no name pattern, the shard's scenarios
  # in this one process. Mirroring CI's command surface is the point; a paraphrase of it is not
  # evidence about CI.
  NEXUS_BROWSER_SHARDS=2 NEXUS_BROWSER_SHARD="$SHARD" \
    node --test "$SUITE" 2>&1 | tee "$LOG"
else
  NEXUS_BROWSER_SHARDS=1 NEXUS_BROWSER_SHARD=0 \
    node --test --test-name-pattern="$SCENARIO" "$SUITE" 2>&1 | tee "$LOG"
fi
RC=${PIPESTATUS[0]}

# A pattern that matches nothing exits 0 with every test skipped, and THE RUNNER'S OWN SUMMARY
# CANNOT TELL YOU THAT: `node --test <file>` reports the FILE itself as one passing test, so a
# pattern matching nothing still prints `# pass 1`, and a pattern matching one scenario that
# contains four subtests prints `# pass 5`. Both were verified before this guard was written.
# The aggregate is insensitive to the only question being asked, which is this project's
# commonest vacuous check — so count the scenarios instead. A scenario is an UNINDENTED TAP
# result line (inner subtests are indented) whose description is not the file path.
scenario_lines() { awk -v want="$1" '
  /^(ok|not ok) [0-9]+ - /{
    verdict = ($1 == "not") ? "fail" : "pass"
    desc = $0; sub(/^(ok|not ok) [0-9]+ - /, "", desc)
    if (desc !~ /\.mjs$/ && (want == "any" || want == verdict)) n++
  } END { print n+0 }' "$LOG"; }
RAN=$(scenario_lines any)
FAILED=$(scenario_lines fail)
PASSED=$((RAN - FAILED))
echo
if [ "$RAN" = 0 ]; then
  echo "browser-probe: NOTHING RAN for '${SHARD:+shard }${SHARD:-$SCENARIO}', so nothing is proven." >&2
  echo "browser-probe: the scenario names are in remote/test/browser.test.mjs (see --help)." >&2
  rm -f "$LOG"; exit 2
fi

# The suite prints its own scenario total on every run. Read it back rather than writing a
# number here: the count changes whenever an application version is added, and a transcribed
# one rots silently. (The suite's own header comment said 28 while the table held 27.)
TOTAL=$(sed -n 's/.*browser shard [0-9]* of [0-9]*: running [0-9]* of \([0-9]*\) scenarios.*/\1/p' "$LOG" | tail -1)
if [ "$RC" = 0 ]; then
  echo "browser-probe: PASS — ${PASSED} of ${TOTAL:-?} scenarios, in a real browser."
  if [ -n "$SHARD" ]; then
    echo "browser-probe: NOT COVERED — CI's other shard, and everything outside remote/."
  else
    echo "browser-probe: NOT COVERED — the other scenario, and everything outside remote/."
  fi
else
  echo "browser-probe: FAIL (exit $RC) — ${FAILED:-?} scenario(s) red. Full log: $LOG" >&2
  echo "browser-probe: before blaming your change, run the SAME scenario on origin/main:" >&2
  echo "browser-probe:   git worktree add /tmp/probe-control origin/main" >&2
  echo "browser-probe: a red on both is not your change." >&2
  exit "$RC"
fi
rm -f "$LOG"
exit 0
