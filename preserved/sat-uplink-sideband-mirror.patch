+/// A Nexus/Hamlib mode NAME as the CI-V pair a rig is written with: the base
+/// mode byte (`06`) and whether the DATA submode (`1A 06`) is on. `None` for a
+/// token this backend cannot command at all.
+///
+/// PKT\*/DATA-\* = base sideband + DATA on; every plain mode turns DATA off.
+/// The rig has no single "PKTUSB" byte — USB-D is `06 01` followed by
+/// `1A 06 01`, which is why this is a PAIR and not a `Mode`.
+///
+/// ⚠️ ONE resolver for the receive dial (`set_mode`, `06` on Main) and the
+/// split TX VFO (`set_split_mode`, `06` on Sub). They drifted before: the
+/// split path resolved through `Mode::from_name` alone, so it answered every
+/// DATA submode "this rig cannot do that" while the dial next to it was being
+/// commanded USB-D on the same bus. Two resolvers is two vocabularies, and the
+/// legs of one QSO must not be derived from different beliefs about the rig.
+fn civ_mode_and_data(name: &str) -> Option<(Mode, bool)> {
+    let up = name.to_ascii_uppercase();
+    Some(match up.as_str() {
+        "PKTUSB" | "DATA-U" | "PKT-U" => (Mode::Usb, true),
+        "PKTLSB" | "DATA-L" | "PKT-L" => (Mode::Lsb, true),
+        _ => (Mode::from_name(&up)?, false),
+    })
+}
