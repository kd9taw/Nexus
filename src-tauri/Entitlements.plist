<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for the signed macOS bundle (bundle.macOS.entitlements).

     audio-input is the one Nexus needs: without it a hardened-runtime app can never reach the
     microphone/USB-audio codec, however good the Info.plist usage string is — macOS won't even
     show the permission prompt, the capture just delivers silence (the waterfall's hardest
     failure shape). ci.yml warned about exactly this gap from the day the mac job was added.

     Nothing else belongs here: Nexus is NOT app-sandboxed, so serial ports, files and the
     network need no entitlements, and WKWebView does its JIT in Apple's own XPC processes. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
