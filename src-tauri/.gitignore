# Rust build output (standalone crate => its own target/).
/target

# Tauri v2 codegen output (generated by tauri-build at compile time).
/gen

# App icons ARE committed (see icons/README.md) — tauri-build needs icon.ico at
# compile time to generate the Windows resource, so a fresh checkout must have them.
# Regenerate with `python3 scripts/gen-icons.py` or `cargo tauri icon <logo.png>`.

# The DeepCW AI CW model (AGPL-3.0, (c) e04) is staged here for bundling but NOT
# committed — see resources/deepcw/README.md for provenance + how to fetch it.
/resources/deepcw/*.onnx
/resources/deepcw/*.onnx.json

# IOTA Ltd's island-group list (© RSGB and IOTA Ltd) ships in the installer by IOTA Ltd's
# permission but is NOT committed: scripts/gen-iota-groups.mjs fetches it here at build time —
# see resources/iota/README.md.
/resources/iota/*.json
