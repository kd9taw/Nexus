# wiki content is staged here, then pushed to the separate tempo.wiki.git repo
.wiki-staging/
rust_out

# Generated design proof sheets (regenerated by ui/design/verify.mjs; not shipped)
ui/design/proof.png
ui/design/proof.html

# libtempo out-of-tree build output
libtempo/build-linux/
libtempo/build-win-configure.log
.pi-vendor/

# Build output — installers and Pi packages. `*.exe` was already covered; these were not,
# and a 32 MB pi-out/Nexus_*_arm64.deb was one `git add -A` away from being permanent.
pi-out/
*.deb
*.AppImage

# Internal planning notes live in the PRIVATE kd9taw/nexus-notes repo and are cloned
# here for convenience. They are deliberately NOT part of the published source.
#
# They used to be tracked here and removed from every publish by a manual scrub. That
# scrub is what let a stale hand-merged libtempo/CMakeLists.txt ship source that could
# not compile for two releases (2026-07-20). Keeping notes out of this repo means the
# published tree IS the tree that gets built and tested — nothing to strip, no drift.
tasks/
# ops/ = internal runbooks (hosting, data-refresh cadences). Same rule as tasks/: kept
# on disk for convenience, never published (they name the private hamtoolssite checkout).
ops/

# The built manual — 10 MB, regenerated by scripts/build-manual-pdf.py.
# Ships as a release asset, not tracked.
docs/Nexus-Manual.pdf

# Python bytecode from the docs/manual build scripts
__pycache__/

# ── Credentials — never tracked ────────────────────────────────────────────
# Added 2026-08-07. Nothing here has ever been committed; this is a floor so a
# stray key or token cannot be added by accident. The pre-push hook is the
# second layer — see .githooks/pre-push and ~/.nexus-leak-patterns.
*.pem
*.key
*_ed25519
*_ed25519.pub
id_rsa*
id_ecdsa*
.env
.env.*
!.env.example
secrets.json
.wrangler/
credentials.json
service-account*.json
