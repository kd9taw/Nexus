== arrlfd special_op=3
-- arrlfd FT8 K1ABC cq_on_air="CQ FD K1ABC FN42"
 run script 0
  messages=FieldDay sends_grid=false start=CallingCq out="CQ FD K1ABC FN42"
  hear "K1ABC W9XYZ 1D WI" -> AwaitConfirm "W9XYZ K1ABC R 2B EMA"
  hear "K1ABC W9XYZ R 1D WI" -> AwaitConfirm "W9XYZ K1ABC R 2B EMA"
  hear "K1ABC W9XYZ RR73" -> Done "W9XYZ K1ABC 73"
  hear "K1ABC W9XYZ 73" -> Done ""
  logged W9XYZ rx[CLASS=1D,SECTION=WI] tx[CLASS=2B,SECTION=EMA] dupe=false
 s&p script 0 cq grid "EN37"
  messages=FieldDay sends_grid=false start=Listening out=""
  answer W9XYZ "EN37" -> AwaitExchange "W9XYZ K1ABC 2B EMA"
  hear "K1ABC W9XYZ 1D WI" -> AwaitExchange "W9XYZ K1ABC 2B EMA"
  hear "K1ABC W9XYZ R 1D WI" -> Done "W9XYZ K1ABC RR73"
  hear "K1ABC W9XYZ RR73" -> Done ""
  hear "K1ABC W9XYZ 73" -> Done ""
  logged W9XYZ rx[CLASS=1D,SECTION=WI] tx[CLASS=2B,SECTION=EMA] dupe=false
